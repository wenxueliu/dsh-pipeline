{
  "name": "dsh-pipeline",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.28.5",
  "description": "Durable DAG orchestration for deepseek-harness: versioned pipeline templates executed as subagents, with session-backed run state",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./tools": {
      "types": "./lib/tools.d.ts",
      "default": "./lib/tools.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "dsh": ">=0.2.2-rc.3 <0.3.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-client.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json && tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "4.6.6"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-agent": "^0.2.2-rc.3",
    "@deepseek-ai/dsh-llm": "^0.2.2-rc.3",
    "@deepseek-ai/dsh-session": "^0.2.2-rc.3",
    "@deepseek-ai/dsh-session-projection": "^0.2.2-rc.3",
    "@deepseek-ai/dsh-storage-domain": "^0.2.2-rc.3",
    "@deepseek-ai/dsh-subagent": "^0.2.2-rc.3",
    "@deepseek-ai/dsh-tools": "^0.2.2-rc.3",
    "@deepseek-ai/dsh-util-values": "^0.2.2-rc.3",
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session-projection": "0.2.2-rc.5",
    "@deepseek-ai/dsh-storage-domain": "0.2.2-rc.5",
    "@deepseek-ai/dsh-subagent": "0.2.2-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.5",
    "@deepseek-ai/dsh-util-values": "0.2.2-rc.5",
    "@deepseek-ai/schemastery": "3.19.0",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-rc.5",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.31",
    "esbuild": "^0.28.2",
    "react": "^18.3.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
